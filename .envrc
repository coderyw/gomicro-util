
export GOPROXY=https://goproxy.cn,direct
# 服务所在命名空间
export NAMESPACE=namespace-ok
# 是否开启命名空间租户监听，默认开启
export ENABLE_LISTEN_TENANT=true
# 商户配置所在nacos命名空间 默认为 tenant
export TENANT_CFG_NACOS_NAMESPACE=tenant
# 商户配置所在nacos dataId 默认为 saas-tenant-meta-mapping
export TENANT_CFG_NACOS_DATAID=saas-tenant-meta-mapping
# 商户配置所在nacos group 默认为 DEFAULT_GROUP
export TENANT_CFG_NACOS_GROUP=DEFAULT_GROUP

# ------  APM
# APM 上报地址
export DD_TRACE_AGENT_HOST=localhost
# APM 上报端口
export DD_TRACE_AGENT_PORT=9529
# 上报到APM上的服务名
export DD_SERVICE=ApmTestServer
# APM 类型
export TRACE_TYPE=orchestrion
# Remove integration service names
export DD_TRACE_REMOVE_INTEGRATION_SERVICE_NAMES_ENABLED=true